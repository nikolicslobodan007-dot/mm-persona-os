# Caddy sam pribavlja i obnavlja Let's Encrypt sertifikat za {$DOMAIN}.
# Uslov: A zapis za {$DOMAIN} pokazuje na IP servera PRE prvog pokretanja.

{$DOMAIN} {

	encode zstd gzip

	# Statika ide direktno s diska, ne kroz gunicorn.
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ── Javni sajt (statika): webkorporacija.com → početna i /bot ──
# Zaseban blok od {$DOMAIN} (to je konzola, os.webkorporacija.com).
# Uslov: A zapis za webkorporacija.com pokazuje na IP ovog servera
# PRE prvog pokretanja, da Caddy pribavi Let's Encrypt sertifikat.
webkorporacija.com {

	encode zstd gzip

	# /bot i /robots.txt statično sa diska (javne strane)
	@sajt path /bot /bot/* /robots.txt
	handle @sajt {
		root * /srv/sajt
		file_server
	}

	# statika aplikacije (css, logo) iz istog volumena kao konzola
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# početna = prijava; renderuje je aplikacija (CSRF/2FA), URL ostaje /
	@root path /
	handle @root {
		rewrite * /console/login
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# ostalo (/console, /console/login, /console/login/2fa, odjava) na aplikaciju
	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Kopirati u .env.prod NA SERVERU i popuniti. Ovaj fajl nikada ne ide u git.
# Lozinke generisati sa:  openssl rand -base64 32

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=

# Domen bez sheme, npr. persona.mercatomaster.com
DOMAIN=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=persona_os
POSTGRES_USER=persona
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Podešavanje Postgresa prema veličini mašine — tabela u deploy/README.md §8.
# Ove vrednosti su za CX23 (4 GB). Posle rescale-a ih promeni pa:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d postgres
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=50

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=persona
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=persona-media

# Canon §10.5 — dimenzija se NIKADA ne hardkoduje u modelu.
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# Canon §9 — policy profil i fail-closed ponašanje.
POLICY_DEFAULT_PROFILE=creator_standard_v1

# Canon §12.1 — Playwright, bez stealth forkova.
BROWSER_ENGINE=playwright
# ~600 MB po kontekstu. CX23 → 1, CX43 → 4.
BROWSER_CONCURRENCY=1

# Canon §6.4 — obavezno za web.read_public.
WEB_READ_USER_AGENT=MercatoMasterBot/1.0 (+https://mercatomaster.com/bot; bot@mercatomaster.com)

# Glavni prekidač za spoljašnje akcije.
# OSTAJE false do GO odluke na kraju Pilota A. Ne menjati ranije.
GLOBAL_EXTERNAL_ACTIONS_ENABLED=false

AUDIT_APPEND_ONLY=true

# ---- F6 runtime (ADR-0008) -------------------------------------------------
# Hladna pošta NIKADA sa ovih domena ni njihovih poddomena (Canon §12.8 t.1).
PRIMARY_COMPANY_DOMAINS=webkorporacija.com,mercatomaster.com,biznisplan.net
# Ime pošiljaoca u podnožju poruke (Zakon o elektronskoj trgovini).
COMPANY_LEGAL_NAME=
# Javna adresa za link odjave (RFC 8058).
PUBLIC_BASE_URL=https://os.webkorporacija.com
# Posao ide worker-u odmah posle ALLOW (inače ga beat pokupi za ≤ 15 s).
RUNTIME_KICK=true
# Keš za tempo po hostu, robots.txt i ETag — zajednički za sve worker-e.
CACHE_URL=redis://redis:6379/1
# Tajne kanala: credential_ref = "env:IME" ili "file:/putanja". Nikad u bazi.

# ---- F7 sadržaj i LLM (ADR-0009) -------------------------------------------
# Prozor „post” u buđenju pravi nacrt (+ predlog objave ako postoji dozvoljen kanal).
CONTENT_AUTODRAFT=true
# Spoljni model samo uz izričito uključivanje; bez toga radi lokalni šablon.
LLM_EXTERNAL_ENABLED=false
# ANTHROPIC_API_KEY=   (zajednički; samo ako je LLM_EXTERNAL_ENABLED=true i ruta dodata u bazu)
# ANTHROPIC_API_KEY_P00001=   (ključ samo za P-00001; ima prednost nad zajedničkim — ADR-0013)
# Svaki agent ima SVOJ ključ (odluka 24.09, ADR-0013 dopuna): bez njega ne
# pozajmljuje zajednički, nego mu nacrte piše lokalni šablon — vidi se u planu.
LLM_REQUIRE_PERSONA_KEY=true

# ---- ADR-0015 — sandučići agenata na Mailcow-u
AGENT_MAIL_DOMAIN=webkorporacija.com
MAILCOW_ENABLED=false
MAILCOW_URL=https://mail.PRIMER.rs
# MAILCOW_API_KEY=        (Read-Write, dozvoljen IP samo naš server)
# MAILBOX_PASSWORD_SECRET= (dugačak nasumičan niz; iz njega se izvode lozinke sandučića)


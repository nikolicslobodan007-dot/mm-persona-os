{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercatomaster.com/schemas/events/plan.created/1.json",
  "title": "plan.created",
  "description": "Canon v1.1 §7.2 — vlasnik: orchestration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_type": {
      "const": "plan.created"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "persona_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^P-\\d{5}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVT-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id"
      ],
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "step_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercatomaster.com/schemas/events/policy.incident.opened/1.json",
  "title": "policy.incident.opened",
  "description": "Canon v1.1 §7.2 — vlasnik: policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_type": {
      "const": "policy.incident.opened"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "persona_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^P-\\d{5}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVT-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "severity",
        "reason_code"
      ],
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "SEV1",
            "SEV2",
            "SEV3",
            "SEV4"
          ]
        },
        "reason_code": {
          "type": "string"
        }
      }
    }
  }
}
